#
# Subscription Portal (local dev)
#

# IMPORTANT:
# - Copy this file to `subscription-portal/.env` (the server loads configuration from `.env`).
# - `.env.example` is only read for UI toggles; `AZDO_*` (and `PORTAL_AZDO_ENABLED`) values here are ignored.

# Server
PORT=3000
HOST=127.0.0.1

# If Azure DevOps vars are NOT set, the portal can read/write locally (dev only).
SUBSCRIPTIONS_CSV_PATH=../infrastructure/subscriptions.csv
PORTAL_WRITE_LOCAL=false

# Optional dropdown defaults (comma-separated)
PORTAL_ENVIRONMENTS=dev,test,prod
PORTAL_MANAGEMENT_GROUPS=LandingZones,Platform,Sandbox
PORTAL_LOCATIONS=westeurope,northeurope

# Default values applied when fields are omitted in the request
PORTAL_DEFAULT_LOCATION=westeurope
PORTAL_DEFAULT_MANAGEMENT_GROUP_ID=LandingZones
PORTAL_DEFAULT_DEPARTMENT=Platform Engineering
PORTAL_DEFAULT_TEAM=Cloud Operations
PORTAL_DEFAULT_COST_CENTER=CC-001
PORTAL_DEFAULT_BILLING_SCOPE=

# UI visibility (true/false)
PORTAL_UI_SHOW_MODE_BANNER=true
PORTAL_UI_SHOW_DRY_RUN=true
PORTAL_UI_SHOW_EXISTING_SUBSCRIPTIONS=true

# AAD bearer auth (optional). When enabled, the frontend sends Authorization: Bearer tokens.
PORTAL_AUTH_BEARER_ENABLED=false
PORTAL_AUTH_AAD_CLIENT_ID=
PORTAL_AUTH_AAD_TENANT_ID=
PORTAL_AUTH_AAD_SCOPES=
# Optional access control (comma-separated AAD group object IDs).
PORTAL_AUTH_ADMIN_GROUPS=
PORTAL_AUTH_REQUESTER_GROUPS=

#
# Azure DevOps integration (managed identity)
# When set, the portal will create a branch + PR updating infrastructure/subscriptions.csv
#
# Set to false to force "local preview" even when AZDO_* are configured (useful for UI testing).
PORTAL_AZDO_ENABLED=false
AZDO_ORG_URL=
AZDO_PROJECT=
AZDO_REPO_ID=
AZDO_AUTH_MODE=managed_identity
AZDO_MANAGED_IDENTITY_CLIENT_ID=
AZDO_TARGET_BRANCH=main
# Repository path updated by portal commits/PRs. Keep the default for real Terraform-backed environments.
AZDO_SUBSCRIPTIONS_PATH=/infrastructure/subscriptions.csv
