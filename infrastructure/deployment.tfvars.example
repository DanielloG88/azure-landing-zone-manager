environment             = "prod"
tfstate_resource_group  = "<state-resource-group>"
tfstate_storage_account = "<state-storage-account>"
billing_scope           = "/providers/Microsoft.Billing/billingAccounts/<billing-account>/billingProfiles/<billing-profile>/invoiceSections/<invoice-section>"
subscription_display_name_prefix = "alz"
project_sp_prefix                 = "spi-alz"
tfstate_monitoring_group_name     = "<monitoring-group>"
management_group_id_aliases = {
  LandingZones = "<landing-zones-management-group-id>"
  Platform     = "<platform-management-group-id>"
  Sandbox      = "<sandbox-management-group-id>"
}
default_subscription_tags = {
  department  = "Platform Engineering"
  team        = "Cloud Operations"
  owner       = "owner@example.com"
  cost-center = "CC-001"
}

# Shared hub catalogues can be downloaded by azure-pipelines.yaml using hubPipelineId.
# Leave this empty when using that catalogue, or populate it with the hub output in secure files.
network_hubs = {}
network_external_address_spaces = {}
network_provider_registration_wait = "90s"
